# DeepSeek-V4.1-Flash on the 4-node GB10 cluster (TP=4), knobs for serve-node.sh.
# One value per line; override any of them in the environment before launching.

# --- cluster (matches the production DS4F layout) ---
MASTER_ADDR=${MASTER_ADDR:-10.100.0.16}      # gx10-6040 on the 200G link
MASTER_PORT=${MASTER_PORT:-29541}
PORT=${PORT:-8889}                           # head OpenAI-compatible API port (production uses 8888)
NIC=${NIC:-enp1s0f0np0}                      # NCCL/TP/GLOO socket interface
HCA=${HCA:-rocep1s0f0,roceP2p1s0f0}          # RoCE HCAs (both ports)
VENV=${VENV:-$HOME/vllm-dsv41-venv}          # venv with this branch installed (VLLM_USE_PRECOMPILED + rebuilt _C_stable_libtorch)

# --- model ---
MODEL=${MODEL:-$HOME/models/DeepSeek-V4.1-Flash}
SERVED_NAME=${SERVED_NAME:-deepseek-v4.1-flash}
TEXT_ONLY=${TEXT_ONLY:-1}                    # 1: --language-model-only (drop the vision tower for the first boots)

# --- engine ---
MAXLEN=${MAXLEN:-131072}
SEQS=${SEQS:-8}
MNBT=${MNBT:-8192}
GMU=${GMU:-0.85}
# KV pool in bytes, set explicitly so vLLM skips memory profiling (78.9 GB of weights
# leave ~35 GiB; FP4 global KV is 890 B/token, so 8 GiB covers 131k x 8 with room).
KVMEM=${KVMEM:-6442450944}                   # 6 GiB with the 4 GiB offload tier (8 GiB + tier does not fit next to 81.5 GiB weights)
EAGER=${EAGER:-0}                            # 1: --enforce-eager (the baseline). 0: CUDA graphs with the sizes
                                             #    below; the runner prefaults the engram rows before each step.
CAPTURE_SIZES=${CAPTURE_SIZES:-1,2,4,8}      # cudagraph_capture_sizes (ascending); with SPEC=dspark the launcher
CAPTURE_SIZES_EXPLICIT=${CAPTURE_SIZES_EXPLICIT:-}  # set to 1 to use CAPTURE_SIZES verbatim even with SPEC=dspark
                                             #    adds every multiple of k and k+1 up to SEQS*(k+1) unless
                                             #    CAPTURE_SIZES_EXPLICIT=1
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-FULL_AND_PIECEWISE}
SPEC=${SPEC:-dspark}                         # none | dspark (dspark adopted 2026-09-11: 2-2.6x on code/json/math/tools)
SPEC_K=${SPEC_K:-5}
SPEC_DRAFT=${SPEC_DRAFT:-greedy}             # draft_sample_method: greedy | probabilistic (identical at temp 0, less memory)
SPEC_REJECT=${SPEC_REJECT:-standard}         # rejection_sample_method: standard | block
SPEC_EXTRA=${SPEC_EXTRA:-}                   # extra speculative-config JSON members; quotes do not survive
                                             #    dsv41_ctl.sh --setenv, so prefer a dedicated knob
THINKING=${THINKING:-true}
EXTRA_ARGS=${EXTRA_ARGS:-}
KVOFF_GIB=${KVOFF_GIB:-4}                    # >0: native CPU KV offload tier (GiB, /dev/shm per node); 0 disables (adopted 4: 8 GiB does not fit)
KVFS_DIR=${KVFS_DIR:-/home/nacyot/dsv41-prep/kvfs}   # with KVOFF_GIB>0: filesystem tier root on the head node (empty disables the disk tier)
KV_RETENTION=${KV_RETENTION:-4096}           # VLLM_PREFIX_CACHE_RETENTION_INTERVAL (tokens): SWA tails once per interval; restores hit up to the last boundary
KV_RELAY=${KV_RELAY:-true}                   # relay_from_rank0 for the multi-node offload (false only for single-node tests)
KV_TRACE=${KV_TRACE:-0}                      # 1: VLLM_KV_OFFLOAD_TRACE (log every relay load)
MEM_TRACE=${MEM_TRACE:-0}                    # 1: log torch allocator state per prefill chunk (memtrace_summary.py)

# --- engram: tables stay in the checkpoint shards, mapped read-only (GB10 ATS) ---
ENGRAM_MMAP=${ENGRAM_MMAP:-1}
ENGRAM_THREADS=${ENGRAM_THREADS:-32}
ENGRAM_RELEASE=${ENGRAM_RELEASE:-3}             # mmap_release_after_steps: drop the pages of rows prefaulted N steps ago (0: leave reclaim to the kernel)

# The safetensors weights iterator is the one that honors the engram skip hook;
# instanttensor/fastsafetensors would read the 98 GB tables into memory.
LOAD_FORMAT=${LOAD_FORMAT:-safetensors}
