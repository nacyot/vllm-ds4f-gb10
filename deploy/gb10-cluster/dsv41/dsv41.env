# DeepSeek-V4.1-Flash on the 4-node GB10 cluster (TP=4), knobs for serve-node.sh.
# One value per line; override any of them in the environment before launching.

# --- cluster (matches the production DS4F layout) ---
MASTER_ADDR=${MASTER_ADDR:-10.100.0.16}      # gx10-6040 on the 200G link
MASTER_PORT=${MASTER_PORT:-29541}
PORT=${PORT:-8888}                           # head OpenAI-compatible API port: the production endpoint since 2026-09-13
                                             #    (the DS4F port; bring-up used 8889)
NIC=${NIC:-enp1s0f0np0}                      # NCCL/TP/GLOO socket interface
HCA=${HCA:-rocep1s0f0,roceP2p1s0f0}          # RoCE HCAs (both ports)
VENV=${VENV:-$HOME/vllm-dsv41-venv}          # venv with this branch installed (VLLM_USE_PRECOMPILED + rebuilt _C_stable_libtorch)
# --- remote frontend (issue #24 spike; empty = rank 0 serves the API as before) ---
FRONTEND_HOST=${FRONTEND_HOST:-}             # node that runs the API server (serve-frontend.sh); rank 0 then boots --headless
FRONTEND_ADDR=${FRONTEND_ADDR:-}             # IP the frontend binds and the head engine dials (200G link, e.g. 10.100.0.32); set with FRONTEND_HOST
DP_RPC_PORT=${DP_RPC_PORT:-29560}            # engine handshake ROUTER port on FRONTEND_ADDR
FRONTEND_TP=${FRONTEND_TP:-4}                # --tensor-parallel-size on the frontend (unused there; 1 is the fallback if the config check rejects 4)
FRONTEND_EXTRA_ARGS=${FRONTEND_EXTRA_ARGS:-}

# --- model ---
MODEL=${MODEL:-$HOME/models/DeepSeek-V4.1-Flash}
SERVED_NAME=${SERVED_NAME:-deepseek-v4.1-flash}
SERVED_ALIASES=${SERVED_ALIASES:-deepseek-v4-flash-0731 deepseek-v4-flash-vision}   # extra --served-model-name values (space separated): clients of the
                                             #    replaced DS4F production keep their model name; empty = none
TEXT_ONLY=${TEXT_ONLY:-0}                    # 0: vision tower loaded (production since 2026-09-13: images accepted, encoder on
                                             #    FLASH_ATTN, boot 160 s, head after boot 4.9 GiB). 1: --language-model-only (bring-up)

# --- engine ---
MAXLEN=${MAXLEN:-524288}                    # 512K: 500K sessions store/restore verified 2026-09-12 (1M boots, see notes)
SEQS=${SEQS:-16}                             # admission limit as in the DS4F TP=4 production
MNBT=${MNBT:-4096}                           # 4096 halves the prefill working set (500K prefill min MemAvailable head 6.8 GiB)
LPTT=${LPTT:-}                               # --long-prefill-token-threshold: per-request prefill chunk cap (empty = MNBT only)
LPTT_MIXED=${LPTT_MIXED:-}                   # DSPARK_LPTT_MIXED: chunk cap only while a decode runs or two prefills compete (DS4F 2048)
PPCAP=${PPCAP:-}                             # DSPARK_PPCAP: at most this many requests prefilling at once (DS4F 1)
PPCAP_LONG_TOKENS=${PPCAP_LONG_TOKENS:-}     # DSPARK_PPCAP_LONG_TOKENS: PPCAP counts and blocks only prompts longer than this (DS4F 4096)
DECODE_STEPS=${DECODE_STEPS:-}               # DSPARK_DECODE_STEPS_PER_PREFILL: decode-only steps after each prefill step while decodes run
GMU=${GMU:-0.80}                             # startup free-memory check only (KVMEM is explicit)
# KV pool in bytes, set explicitly so vLLM skips memory profiling (78.9 GB of weights
# leave ~35 GiB; FP4 global KV is 890 B/token, so 8 GiB covers 131k x 8 with room).
KVMEM=${KVMEM:-17179869184}                  # 16 GiB = 4.57M tokens (493K x 9); 500K x 7 resident verified, head keeps >= 6.8 GiB during a 500K prefill
EAGER=${EAGER:-0}                            # 1: --enforce-eager (the baseline). 0: CUDA graphs with the sizes
                                             #    below; the runner prefaults the engram rows before each step.
CAPTURE_SIZES=${CAPTURE_SIZES:-1,2,4,8}      # cudagraph_capture_sizes (ascending); with SPEC=dspark the launcher
CAPTURE_SIZES_EXPLICIT=${CAPTURE_SIZES_EXPLICIT:-}  # set to 1 to use CAPTURE_SIZES verbatim even with SPEC=dspark
                                             #    adds every multiple of k and k+1 up to SEQS*(k+1) unless
                                             #    CAPTURE_SIZES_EXPLICIT=1
CUDAGRAPH_MODE=${CUDAGRAPH_MODE:-FULL_DECODE_ONLY}  # decode graphs only: 1.3 GiB -> 0.5 GiB, capture 6-32 s, C4 +6%
SPEC=${SPEC:-dspark}                         # none | dspark (dspark adopted 2026-09-11: 2-2.6x on code/json/math/tools)
SPEC_K=${SPEC_K:-5}
SPEC_DRAFT=${SPEC_DRAFT:-greedy}             # draft_sample_method: greedy | probabilistic (identical at temp 0, less memory)
SPEC_REJECT=${SPEC_REJECT:-standard}         # rejection_sample_method: standard | block
SPEC_EXTRA=${SPEC_EXTRA:-}                   # extra speculative-config JSON members; quotes do not survive
                                             #    dsv41_ctl.sh --setenv, so prefer a dedicated knob
THINKING=${THINKING:-true}
MM_IMAGES=${MM_IMAGES:-512}                    # --limit-mm-per-prompt image count with TEXT_ONLY=0 (owner 2026-09-13: images are used
                                             #    freely; the model itself sets no limit, each image is at most 1,024 tokens, a 512K
                                             #    prompt holds ~500 of them). Empty = the vLLM default (999).
EXTRA_ARGS=${EXTRA_ARGS:-}
# --- kernel / parallel levers (issue #12 prefill work; empty = vLLM auto) ---
MOE_BACKEND=${MOE_BACKEND:-}                 # deep_gemm (auto pick on SM121) | b12x (needs b12x==1.3.0 in VENV, no EP) | deep_gemm_mega_moe (needs EP=1)
LINEAR_BACKEND=${LINEAR_BACKEND:-}           # b12x: B12xMxfp8LinearKernel for the dense MXFP8 GEMMs (needs b12x==1.3.0 in VENV)
EP=${EP:-0}                                  # 1: --enable-expert-parallel (TP=4, DP=1 -> 96 experts x full width per rank, no all2all)
PROFILER_DIR=${PROFILER_DIR:-}               # set to arm the torch profiler (/start_profile, /stop_profile on the head); traces per rank under this dir
KVOFF_GIB=${KVOFF_GIB:-3}                    # head-only host tier (relay). Rows are sized per KV cache group (issue #2): 3 GiB =
                                             #    8,657 x 139,264 B (g15) + 5,275 x 114,688 B (SWA g0-g12) + 18,125 x 77,824 B (g13/g14/g17) = 32,057 slots;
                                             #    each slab holds ~2.1 max-length sessions (493K measured: 3,851 + ~400 + ~8,100 chunks -> slabs 52%/8%/51%). Before #2: 23,130 uniform rows.
KVOFF_SLABS=${KVOFF_SLABS:-1}                # 0: one uniform row size (the pre-#2 layout, 23,130 slots at 3 GiB) (rollback switch)
KVOFF_SLAB_SHARES=${KVOFF_SLAB_SHARES:-}     # weights per row size, e.g. 139264:0.4,77824:0.4,114688:0.2 (or JSON); empty = split by the
                                             #    bytes one max-length session leaves in each slab (read vllm:kv_offload_cpu_slab_usage_perc)
KVFS_DIR=${KVFS_DIR:-/mnt/kvdisk/kv/dsv41}    # with KVOFF_GIB>0: filesystem tier root on the head node (empty disables the disk tier).
                                             #    Production (2026-09-13): the external 3.6 TB USB SSD /mnt/kvdisk (the DS4F KV disk), retention by
                                             #    kvfs-gc.timer (systemd/); the bring-up store was ~/dsv41-prep/kvfs on the root NVMe (moved with rsync -aX)
KV_RETENTION=${KV_RETENTION:-8192}           # VLLM_PREFIX_CACHE_RETENTION_INTERVAL (tokens): SWA tails once per interval (halves tail chunks vs 4096)
KV_RELAY=${KV_RELAY:-true}                   # relay_from_rank0 for the multi-node offload (false only for single-node tests)
KV_TRACE=${KV_TRACE:-0}                      # 1: VLLM_KV_OFFLOAD_TRACE (log every relay load)
KV_RELAY_WINDOW_MIB=${KV_RELAY_WINDOW_MIB:-64}   # relay broadcast staging window on each GPU (MiB)
FI_WORKSPACE_MIB=${FI_WORKSPACE_MIB:-128}    # VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE override (MiB; vLLM default 394)
NCCL_LEAN=${NCCL_LEAN:-1}                    # NCCL_BUFFSIZE 1 MiB, LL128 256 KiB, PROTO ^LL128, MAX_NCHANNELS 8: +6-8 GiB/node, bench unchanged (MiaAI TP=4 profile)
MEM_TRACE=${MEM_TRACE:-0}                    # 1: log torch allocator state per prefill chunk (memtrace_summary.py)
ALLOC_CONF=${ALLOC_CONF:-expandable_segments:True}  # torch allocator: reserved-allocated 4.7 -> 0.8 GiB
EMPTY_CACHE=${EMPTY_CACHE:-1}                # 1: torch.cuda.empty_cache() after each prefill run (returns 2.4 GiB of unified memory to the OS).
                                             #    0 measured 2026-09-12 (#12): the re-growth of that 2.4 GiB (66 cuMemCreate) stalls 7-13 s on a
                                             #    fragmented node about one request in three, and 0 lifts the 32K prefill 1,523 -> 1,688 tok/s,
                                             #    but it leaves the head at ~3 GiB after a 493K session (min 2.70 GiB during the prefill, earlyoom
                                             #    line 2.4): an unrelated ~1 GiB host process then got the worker killed. Kept at 1; see issue #15.
EMPTY_CACHE_MIN_TOKENS=${EMPTY_CACHE_MIN_TOKENS:-65536}   # with EMPTY_CACHE=1: release only after a prefill run of at least this many tokens (issue #15).
                                             #    32K requests keep their segments (no re-growth stall between them); a >=64K session still
                                             #    hands its 2.4 GiB back afterwards. 0: release after every prefill run (the pre-#15 behaviour).
                                             #    Measured 2026-09-12 (#15): 32K x5 1,677 tok/s with no stalled run (min 96% of median) and no
                                             #    release; 493K cold prefill 387 s then one release of 2.9 GiB, head MemAvailable back to 4.9 GiB;
                                             #    P13 restore 18.3 s; bench2 C1 53.5/48.3, C4 34.5/123.9; greedy unchanged. Adopted.

# --- engram: tables stay in the checkpoint shards, mapped read-only (GB10 ATS) ---
ENGRAM_MMAP=${ENGRAM_MMAP:-1}
ENGRAM_THREADS=${ENGRAM_THREADS:-32}
ENGRAM_RELEASE=${ENGRAM_RELEASE:-3}             # mmap_release_after_steps: drop the pages of rows prefaulted N steps ago (0: leave reclaim to the kernel)
ENGRAM_PREFETCH=${ENGRAM_PREFETCH:-1}           # 1: hash the next chunk of each prefill and populate its pages (and run the page releases) in a
                                                #    background thread (adopted 2026-09-12, #12: the synchronous prefault + release idled the GPU
                                                #    0.35-0.72 s per step per rank; 32K prefill 1,368 -> 1,523 tok/s)

# --- loader (adopted 2026-09-12: target weights 210 s -> 66 s, draft 33 s -> 2.4 s, weights sha256-identical on all 4 ranks) ---
# instanttensor: direct I/O, the four ranks split the read and broadcast over NCCL (4.6 GB/s). The two
#   Engram shards (47/48, 189 GB of tables) stay out of its list; only their small q/k/wkv tensors are
#   read lazily, where the engram skip hook applies per tensor. MemAvailable stays ~20 GiB during the
#   stream; the guard below turns a regression into a clean failure instead of a UVM thrash.
#   The first long cold prefill after a boot runs 2-15 s slower (the head swaps out 0.2-0.8 GB of
#   cold anonymous pages that a safetensors boot evicted during its 210 s load); steady state is
#   unchanged (8K store TTFT 8.5-8.8 s). Send one warm-up request after boot before measuring.
# safetensors: the previous default (mmap, one thread per rank, every rank reads the whole checkpoint, cold 210 s).
LOAD_FORMAT=${LOAD_FORMAT:-instanttensor}
INSTANTTENSOR_DRAFT_LOADER=${INSTANTTENSOR_DRAFT_LOADER:-instanttensor}   # instanttensor: the pruned draft streams its 3 shards (2.4 s) | auto: lazy safetensors for a folded draft (5.5 s) | safetensors
DSPARK_DRAFT_PRUNE=${DSPARK_DRAFT_PRUNE:-1}     # 1: the draft opens only the shards holding mtp.* (3 of 48 per index.json); 0: scan every shard (33 s)
VLLM_INSTANTTENSOR_MEMAVAIL_MIN_GIB=${VLLM_INSTANTTENSOR_MEMAVAIL_MIN_GIB:-6}   # abort an instanttensor load cleanly once MemAvailable drops below this (GiB); 0 disables
DSPARK_STATE_DIGEST=${DSPARK_STATE_DIGEST:-}    # validation boots: <path prefix> -> <prefix>-rank{r}.txt, per-tensor sha256 of target+draft weights after warmup
